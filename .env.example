# ============================================
# SIEM in a Box (SIB) Configuration
# ============================================
# Copy this file to .env and customize values
# ============================================

# ==================== Grafana ====================
# Leave empty or CHANGE_ME to auto-generate secure password on install
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Grafana is loopback-only by default. Set GRAFANA_BIND_ADDR=0.0.0.0 to expose it on a LAN.
GRAFANA_BIND_ADDR=127.0.0.1
GRAFANA_PORT=3000

# ==================== Falco ====================
# Minimum priority for alerts: debug, info, notice, warning, error, critical, alert, emergency
FALCO_PRIORITY=notice
# Buffered outputs for better performance
FALCO_BUFFERED_OUTPUTS=true
# Time format: iso8601, rfc2822
FALCO_TIME_FORMAT=iso8601

# ==================== Falcosidekick ====================
# Falcosidekick is loopback-only by default. Set SIDEKICK_BIND_ADDR=0.0.0.0 only for fleet collectors, preferably with mTLS/firewall rules.
SIDEKICK_BIND_ADDR=127.0.0.1
SIDEKICK_PORT=2801
SIDEKICK_DEBUG=false
# Minimum priority to forward: debug, informational, notice, warning, error, critical, alert, emergency
SIDEKICK_MINIMUM_PRIORITY=notice

# ==================== Stack Selection ====================
# Choose your monitoring stack:
#   vm      - VictoriaLogs + VictoriaMetrics + node_exporter (recommended, lightweight)
#   grafana - Loki + Prometheus + Alloy (Grafana ecosystem)
STACK=vm

# ==================== Storage ====================
# Grafana Stack (STACK=grafana)
LOKI_PORT=3100
LOKI_RETENTION_PERIOD=168h
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=5GB

# VictoriaMetrics Stack (STACK=vm)
VICTORIALOGS_VERSION=v1.50.0
VICTORIAMETRICS_VERSION=v1.144.0
VMAGENT_VERSION=v1.144.0
NODE_EXPORTER_VERSION=v1.11.1
VECTOR_VERSION=0.55.0-alpine
ALLOY_VERSION=v1.16.1
SIB_ANSIBLE_VERSION=local
VICTORIALOGS_PORT=9428
VICTORIALOGS_RETENTION_PERIOD=168h
VICTORIAMETRICS_PORT=8428
VICTORIAMETRICS_RETENTION_PERIOD=15d

# Storage bind address (127.0.0.1 = local only, 0.0.0.0 = accept remote collectors)
# Use 'make enable-remote' to enable remote collectors
STORAGE_BIND=127.0.0.1

# ==================== Optional Outputs ====================
# Uncomment and configure outputs as needed, then run 'make install-alerting'
# (or 'make install') to regenerate alerting/config/config.yaml.
# An output is enabled only when its URL/key below is set.
# Each *_MINIMUM_PRIORITY defaults to the global SIDEKICK_MINIMUM_PRIORITY.
# For outputs not listed here, see alerting/config/custom-outputs.yaml.example

# Generic webhook (Hermes Agent, automation relays, custom incident handlers)
# WEBHOOK_ADDRESS=http://incident-handler.example:8644/webhooks/falco
# WEBHOOK_HEADER_NAME=X-Gitlab-Token
# WEBHOOK_HEADER_VALUE=replace-with-route-secret
# WEBHOOK_MINIMUM_PRIORITY=warning

# Slack
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# SLACK_CHANNEL=#security-alerts
# SLACK_MINIMUM_PRIORITY=warning

# Discord
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXX/YYY
# DISCORD_MINIMUM_PRIORITY=warning

# PagerDuty
# PAGERDUTY_ROUTING_KEY=your-routing-key
# PAGERDUTY_MINIMUM_PRIORITY=critical

# Opsgenie
# OPSGENIE_API_KEY=your-api-key
# OPSGENIE_REGION=us
# OPSGENIE_MINIMUM_PRIORITY=critical

# Teams
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/XXX
# TEAMS_MINIMUM_PRIORITY=warning

# Elasticsearch
# ELASTICSEARCH_HOST_PORT=http://elasticsearch:9200
# ELASTICSEARCH_INDEX=falco

# ==================== mTLS (Fleet Security) ====================
# Enable mutual TLS for encrypted communication between fleet agents and server
# Requires certificates: run 'make generate-certs' first
MTLS_ENABLED=false

# ==================== AI Analysis (Optional) ====================
# Install with: make install-analysis
# Provider: anthropic, openai, ollama
LLM_PROVIDER=anthropic

# Analysis API bind address (127.0.0.1 = local only, 0.0.0.0 = allow browser access)
ANALYSIS_BIND=127.0.0.1
ANALYSIS_PORT=5000
# Analysis API host for Grafana data links (auto-detected if empty)
# ANALYSIS_HOST=192.168.1.100

# Shared secret for the Analysis API. Every endpoint except /health requires it.
# Leave as CHANGE_ME to auto-generate on 'make install-analysis'.
# Analysis triggers billed LLM calls — do not run this API without a token.
ANALYSIS_API_TOKEN=CHANGE_ME
# Origins allowed to call the API cross-origin (comma-separated, default: none)
# ANALYSIS_CORS_ORIGINS=http://grafana.example.com:3000

# Anthropic (Claude) - recommended
ANTHROPIC_API_KEY=your-api-key
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
# OPENAI_API_KEY=your-api-key
# OPENAI_MODEL=gpt-4o

# Ollama (local - for privacy)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# ==================== AIB Integration (Optional) ====================
# Assets in a Box — enriches Falco alerts with asset metadata, blast radius,
# and audit findings before LLM analysis. Leave blank to disable.
# AIB_BASE_URL=http://aib:8080
# AIB_API_TOKEN=your-aib-api-token
