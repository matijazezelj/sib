# ==============================================
# vmagent Configuration for SIB Fleet Collectors
# ==============================================
# Scrapes local node_exporter and sends to SIB VictoriaMetrics

global:
  scrape_interval: 30s
  scrape_timeout: 10s

scrape_configs:
  # Host metrics via node_exporter
  # Local Falco (webserver on 127.0.0.1); up{job="falco"} is SIB's liveness signal
  - job_name: 'falco'
    static_configs:
      - targets: ['127.0.0.1:8765']
    metrics_path: '/metrics'

  - job_name: 'node'
    static_configs:
      - targets: ['localhost:9100']
