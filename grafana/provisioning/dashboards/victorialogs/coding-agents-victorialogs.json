      "id": 7,
      "title": "HIB daemons per host",
      "description": "Heartbeats, starts and stops per host and HIB version. A daemon that stopped cleanly shows a stop; one that crashed only stops sending heartbeats (alert: HIB daemon not running).",
      "type": "table",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "source:hib $hostname event:in(daemon.alive, daemon.start, daemon.stop) | stats by (hostname, hib_version) count() if (event:daemon.alive) as Heartbeats, count() if (event:daemon.start) as Starts, count() if (event:daemon.stop) as Stops",
          "queryType": "stats",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "valueLabel": "__name__"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "hostname": 0,
              "hib_version": 1,
              "Heartbeats": 2,
              "Starts": 3,
              "Stops": 4
            },
            "renameByName": {
              "hostname": "Host",
              "hib_version": "HIB version"
            }
          }
        }
      ]
    },
