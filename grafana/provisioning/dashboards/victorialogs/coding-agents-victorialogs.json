      "id": 13,
      "title": "Critical and security HIB events",
      "description": "Every critical event, plus protected.reverted, home.changed, events.key_refused, scope.unavailable, sandbox.unavailable, auth.failure, data.block, terminal.open and daemon starts in test mode. Expand a line for its changes, reason or session.",
      "type": "logs",
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "source:hib $hostname (severity:critical or event:in(protected.reverted, home.changed, events.key_refused, scope.unavailable, sandbox.unavailable, auth.failure, data.block, terminal.open) or (event:daemon.start script_driver:true))",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },
