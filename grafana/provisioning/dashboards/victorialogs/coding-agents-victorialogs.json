      },
      "id": 15,
      "title": "Falco coding-agent hits by session",
      "description": "session= is the HIB_SESSION variable (best effort), scope is the session's systemd scope from cgroups= (session_scope = true). Empty: the agent ran outside HIB or the variable didn't reach Falco.",
      "type": "table",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "desc": true,
            "displayName": "Hits"
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "source:syscall $hostname tags:coding_agent | extract_regexp \"session=(?P<session>[^ ]*) cgroups=\" | extract_regexp \"(?P<scope>hib-w_[0-9a-f]+-[0-9a-f]+[.]scope)\" | stats by (hostname, rule, session, scope) count() as Hits",
          "queryType": "stats",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "valueLabel": "__name__"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "hostname": 0,
              "rule": 1,
              "session": 2,
              "scope": 3,
              "Hits": 4
            },
            "renameByName": {
              "hostname": "Host",
