      "id": 1,
      "title": "HIB daemons up",
      "description": "Hosts with a HIB heartbeat (daemon.alive) or daemon.start in the last 15 minutes.",
      "type": "stat",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "green",
            "mode": "fixed"
          },
          "noValue": "0"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "source:hib $hostname _time:15m event:in(daemon.alive, daemon.start) | stats count_uniq(hostname) as Hosts",
          "queryType": "stats",
          "refId": "A"
        }
      ]
    },
