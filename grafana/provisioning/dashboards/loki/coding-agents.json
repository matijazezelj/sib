          "expr": "{source=\"hib\", hostname=~\"$hostname\"} | json script_driver | severity=\"critical\" or event=~\"protected[.]reverted|home[.]changed|events[.]key_refused|scope[.]unavailable|sandbox[.]unavailable|auth[.]failure|data[.]block|terminal[.]open\" or (event=\"daemon.start\" and script_driver=\"true\")",
