      "id": 1,
      "title": "HIB daemons up",
      "description": "Hosts with a HIB heartbeat (daemon.alive) or daemon.start in the last 15 minutes.",
      "type": "stat",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "green",
            "mode": "fixed"
          },
          "noValue": "0"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(count by (hostname) (count_over_time({source=\"hib\", hostname=~\"$hostname\", event=~\"daemon[.](alive|start)\"}[15m])))",
          "refId": "A",
          "queryType": "instant"
        }
      ]
    },
